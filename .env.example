# Copy this file to .env and fill in your keys
# Never commit .env to version control

# LLM API Keys (use whichever you prefer)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional LLM response polisher (default off — deterministic output only)
USE_LLM_POLISHER=false
# Back-compat alias:
# LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECS=8
LLM_MAX_OUTPUT_TOKENS=600
# Cap API calls during local testing (omit for no cap)
# LLM_MAX_POLISH=3
# LLM_DEBUG=true

# Optional: Embedding model keys
COHERE_API_KEY=
VOYAGE_API_KEY=
