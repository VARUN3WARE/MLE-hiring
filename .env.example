# Copy this file to .env and fill in your keys
# Never commit .env to version control

# LLM API Keys (use whichever you prefer)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Gated LLM drafting (optional)
# Model suggestions: gpt-4o-mini (OpenAI), claude-3-5-haiku (Anthropic), etc.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECS=8
LLM_ENABLED=false

# Optional: Embedding model keys
COHERE_API_KEY=
VOYAGE_API_KEY=
